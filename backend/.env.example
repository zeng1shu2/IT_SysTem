# ===== Database =====
# DB_TYPE: sqlite (local dev) or mysql (production)
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=it_system_os

# ===== JWT =====
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== App =====
APP_NAME=IT_SysTem_OS
APP_VERSION=1.0.0
DEBUG=True
